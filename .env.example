# Copia este archivo como .env y completa los valores.
# El .env real nunca se sube al repositorio.

# Supabase: Project Settings > API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=sb_publishable_TU_CLAVE_PUBLICABLE

# Clave de servicio: Project Settings > API > service_role.
# Solo la usan los scripts locales. Da acceso total a la base: no la compartas.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE

# TMDB: https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=TU_TOKEN_V4
TMDB_API_KEY=TU_API_KEY_V3
